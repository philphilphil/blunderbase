{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blunderbase",
  "version": "0.10.0",
  "identifier": "app.blunderbase.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blunderbase",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../.pyinstaller/dist/blunderbase-desktop/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
